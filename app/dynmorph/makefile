include ../../config
include ../../libinfo
include ../config.app
PROJNAME_HYPHEN=$(shell echo ${PROJNAME} | sed 's/_/-/')

BINDIR=$(PREFIX)/bin

INSTALL=install -m 755
UNINSTALL=rm -f

CONFIGTOOL=$(PROJNAME_HYPHEN)-config
LINK=`$$(command -v $(CONFIGTOOL)) -l` $(APPLINK)
LINKCPP=`$$(command -v $(CONFIGTOOL)) -lcpp` $(APPLINKCPP)

CC=gcc
CXX=g++
CFLAGS= -Wall -O3 `$$(command -v $(CONFIGTOOL)) --cflags`
TARGET=$(shell ls *.c 2> /dev/null | xargs -I{} basename {} .c | xargs)

CHKDEP=`which zeda-chkdep`

OBJ=dm_scene.o dm_console.o
VPATH=util
all: dependency $(TARGET)
dependency:
ifneq ($(CHKDEP),)
ifneq ($(DEPENDENCY),)
	@$(CHKDEP) $(DEPENDENCY) || exit 1
endif
endif

dynmorph: dynmorph.c $(OBJ)
	@echo " CC	" $<
	@$(CC) $(CFLAGS) -o $@ $^ $(LINK)

%: %.c
	@echo " CC	" $<
	@$(CC) $(CFLAGS) -o $@ $< $(LINK)
%: %.cpp
	@echo " CXX	" $<
	@$(CXX) $(CFLAGS) -o $@ $< $(LINKCPP)
clean:
	@echo " CLEAN"
	-@rm -f *.o *~ core $(TARGET)
install: $(TARGET)
ifneq ($(TARGET),)
	@echo " INSTALL	" $^
	@$(INSTALL) $^ $(BINDIR)
endif
uninstall:
ifneq ($(TARGET),)
	@echo " UNINSTALL	" $(TARGET)
	@cd $(BINDIR); $(UNINSTALL) $(TARGET)
endif
